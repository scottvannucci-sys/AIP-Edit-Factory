# local state
.venv/
__pycache__/
_work/
*.pyc

# per-machine data & generated artifacts
inbox/
output/
archive/
test_clips/

# media never belongs in git
*.mp4
*.mov
*.m4v
*.wav
*.mkv
*.ass

# secrets & personal data - never commit
config.json            # holds pa_api + typesafe API keys
campaigns.json         # your campaign pipeline data
oink_import/           # earnings exports (financial data)
studio/                # saved scripts (studio.py module is tracked, this is the data dir)
samples/*              # personal export samples; keep only the README
!samples/README.md
